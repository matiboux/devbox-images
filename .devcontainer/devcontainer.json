{
	"name": "python-devbox",
	"dockerComposeFile": ["docker-compose.yml"],
	"service": "devcontainer",
	"workspaceFolder": "/workdir",
	"shutdownAction": "stopCompose",
	"postCreateCommand": "uv sync --frozen",
	"customizations": {
		"vscode": {
			"extensions": [
				"charliermarsh.ruff",
				"ms-python.python",
				"mhutchie.git-graph"
			]
		},
		"settings": {
			"python.defaultInterpreterPath": "/workdir/.venv/bin/python"
		}
	}
}
